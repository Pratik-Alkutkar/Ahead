# Copy to backend/.env and fill in. Never commit .env.
NESSIE_API_KEY=
# e.g. postgres://user:pass@host:port/tsdb?sslmode=require
DATABASE_URL=
# Written by seed into cache/ids.json; set here only to override.
CUSTOMER_ID=
NVIDIA_API_KEY=
ASR_FUNCTION_ID=
TTS_FUNCTION_ID=
NMT_FUNCTION_ID=
GEMINI_API_KEY=
# Optional: override the Gemini model
GEMINI_MODEL=gemini-3.5-flash
# Nessie v2 (key from v2.nessieisreal.com/account, starts with nsk_)
NESSIE_URL=https://v2-prod-api.nessieisreal.com
# Optional: separate keys per speech model (else NVIDIA_API_KEY)
ASR_API_KEY=
TTS_API_KEY=
